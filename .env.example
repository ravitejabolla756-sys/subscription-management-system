# Public Supabase values. Safe to expose to browser code when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase secret. Never prefix with NEXT_PUBLIC_ and never expose it to clients.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Supabase CLI/deployment metadata. Do not place access tokens in this file.
SUPABASE_PROJECT_REF=your-project-ref

# Application-owned secret for the future billing scheduler endpoint.
CRON_SECRET=replace_with_a_random_32_byte_secret
